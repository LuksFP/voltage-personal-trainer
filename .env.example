# Supabase — copie para .env.local e preencha (NÃO comitar .env.local)
# Painel: Project Settings → API

# URL do projeto e chave pública (client no navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de SERVIÇO — só no servidor (route handlers do portal).
# Ignora a RLS: usada para gravar em nome do aluno após validar o portal_token.
# NUNCA expor no client nem prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
